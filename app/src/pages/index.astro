---
import Layout from "../layouts/Layout.astro";
import { states } from "../data/states";
import roasters from "../data/coffee-roasters.json";
import sellers from "../data/coffee-roasters-multi.json";
const all = [...roasters, ...sellers];
const cafes = all.filter(roaster => roaster.hasCafe).length;
---
<Layout>
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="hero-copy"><p class="eyebrow">Good coffee. A little closer.</p><h1 id="home-heading">Find your next<br />favourite roast.</h1><p class="hero-description">A directory of Australian coffee roasters. Find beans for home, a cafe nearby, or a new roaster to explore.</p><div class="hero-actions"><a href="/roasters/" class="btn btn-primary">Explore the directory <span aria-hidden="true">↗</span></a><a href="/map/" class="text-button">Find a cafe on the map <span aria-hidden="true">→</span></a></div></div>
    <div class="hero-art" aria-hidden="true"><div class="coffee-orbit"></div><svg viewBox="0 0 320 320" fill="none"><circle cx="160" cy="160" r="130" stroke="currentColor" stroke-width="1"/><circle cx="160" cy="160" r="106" stroke="currentColor" stroke-width="1"/><path d="M102 125h113v60a54 54 0 0 1-54 54h-5a54 54 0 0 1-54-54v-60Z" fill="var(--color-base-100)" stroke="currentColor" stroke-width="6"/><path d="M215 139h13a25 25 0 0 1 0 50h-13M89 251h145M133 98c-18-23 17-27 0-49m29 49c-18-23 17-27 0-49m29 49c-18-23 17-27 0-49" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></svg><span class="art-caption">Roasted here. Enjoyed anywhere.</span></div>
  </section>
  <dl class="directory-stats"><div><dt>Directory listings</dt><dd>{all.length}</dd></div><div><dt>With a cafe</dt><dd>{cafes}</dd></div><div><dt>States & territories</dt><dd>8</dd></div></dl>
  <section class="state-section" aria-labelledby="states-heading"><div class="section-heading"><div><p class="eyebrow">Start close to home</p><h2 id="states-heading">Coffee, state by state.</h2></div><a href="/roasters/" class="text-button">Browse all listings <span aria-hidden="true">→</span></a></div><ul class="state-index">{states.map(state => <li><a href={`/roasters/${state.code}/false/1`} aria-label={`${state.code} — ${state.name}`}><span class="state-code">{state.code}</span><span>{state.name}<small>{all.filter(roaster => roaster.State.split(',').map(s => s.trim()).includes(state.code)).length} listings</small></span><span aria-hidden="true">↗</span></a></li>)}</ul></section>
  <section class="discovery-note"><div><p class="eyebrow">A different roast in every delivery</p><h2>Keep your coffee curious.</h2><p>Browse multi-roaster sellers to try beans from more than one roastery.</p></div><a href="/roasters/online-subscriptions/1" class="btn btn-secondary">Explore multi-roaster sellers <span aria-hidden="true">↗</span></a></section>
</Layout>
