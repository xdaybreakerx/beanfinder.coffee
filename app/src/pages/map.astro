---
import Layout from "../layouts/Layout.astro";
import FilterDrawer from "../components/FilterDrawer.astro";
import MonolithicGoogleMap from "../components/ReactGoogleMap";
import { getSecret } from "astro:env/server";

const apiKey = getSecret("GOOGLE_MAPS_API_KEY");
---

<Layout title="Australian Coffee Roasters">
  <div class="page-intro"><p class="eyebrow">Good coffee, on the map</p><h1>Find a roaster nearby.</h1><p>Explore verified Australian locations. Select a marker for details and directions.</p></div>
  <FilterDrawer>
    <div slot="main-content" id="wrapper">
      <MonolithicGoogleMap apiKey={apiKey} client:only="react" />
    </div>
  </FilterDrawer>
</Layout>
