---
// Keep existing bookmarks working while all state browsing uses the directory.
export const prerender = false;
import { states } from '../../../../data/states';
const { state, cafe, page } = Astro.params;
const pageNumber = Number(page);
if (!states.some(item => item.code === state) || !['true', 'false'].includes(cafe) ||
    !/^\d+$/.test(page) || !Number.isSafeInteger(pageNumber) || pageNumber < 1) {
  return new Response('Not found', { status: 404 });
}
const params = new URLSearchParams(Astro.url.searchParams);
params.delete('type');
params.set('state', state);
if (cafe === 'true') params.set('cafe', 'true'); else params.delete('cafe');
if (pageNumber > 1) params.set('page', String(pageNumber)); else params.delete('page');
return Astro.redirect(`/roasters/?${params}`, 301);
---
