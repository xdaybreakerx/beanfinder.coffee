---
export const prerender = true;

import { sellers as stores } from '../../../utils/directory';

import Layout from "../../../layouts/Layout.astro";

import FilterDrawer from "../../../components/FilterDrawer.astro";
import MultiRoasterRow from '../../../components/MultiRoasterRow.astro';
import Pagination from "../../../components/Pagination.astro";

interface PaginatedPage {
  data: typeof stores;
  currentPage: number;
  lastPage: number;
}

export async function getStaticPaths({ paginate }) {
  return paginate([...stores].sort((a, b) => a.Name.localeCompare(b.Name)), { pageSize: 12 });
}

const page = Astro.props.page as PaginatedPage;
const prevUrl = `/roasters/online-subscriptions/${page.currentPage - 1}`;
const nextUrl = `/roasters/online-subscriptions/${page.currentPage + 1}`;
---

<Layout>
  <div class="page-intro"><p class="eyebrow">More roasters. More to discover.</p><h1>Explore multi-roaster sellers.</h1><p>Find services and shops bringing beans from different roasters together.</p></div>

  <FilterDrawer showStateFilter={false} showMultiRoasterFilter={false}>
    <div slot="main-content" id="wrapper">
      <section id="list-of-roasters" class="directory-table seller-table" aria-label="Multi-roaster stores">
        <div class="list-heading seller-heading" aria-hidden="true"><span>Store</span><span>Subscription</span><span>Selection</span><span>Brew</span></div>
        <div
          class="roaster-list"
        >
          {page.data.map(store => <MultiRoasterRow store={store} />)}
        </div>
      </section>

      <!-- Pagination -->
      {
        page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            lastPage={page.lastPage}
            prevUrl={prevUrl}
            nextUrl={nextUrl}
          />
        )
      }
    </div>
  </FilterDrawer>
</Layout>
