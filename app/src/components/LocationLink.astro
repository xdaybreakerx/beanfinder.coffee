---
interface Props { href: string; locality: string; roasterName: string; }
const { href, locality, roasterName } = Astro.props;
const label = locality.replace(/\s+\d{4}$/, '');
---
<a class="cafe-map-link link link-hover flex items-start gap-1.5" href={href} target="_blank" rel="noopener noreferrer">
  <svg class="map-pin w-4 shrink-0" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
  <span class="location-label">{label}<span class="sr-only"> — View {roasterName} on Google Maps (opens in a new tab)</span></span>
</a>
