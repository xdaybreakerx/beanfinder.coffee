---
import RoasterRow from "./RoasterRow.astro";
import roasters from "../data/coffee-roasters.json";
import sellers from "../data/coffee-roasters-multi.json";
import { states } from "../data/states";
const listings = [...roasters, ...sellers].sort((a, b) => a.Name.localeCompare(b.Name));
---
<div class="directory-tools">
  <div class="search-field"><label for="directory-search">Find a roaster</label><input id="directory-search" type="search" placeholder="Search by name, suburb or website" autocomplete="off" /></div>
  <div id="directory-state-field"><label for="directory-state">State or territory</label><select id="directory-state"><option value="">All Australia</option>{states.map(state => <option value={state.code}>{state.name}</option>)}</select></div>
  <div><label for="directory-type">Listing type</label><select id="directory-type"><option value="">All listings</option><option value="roaster">Coffee roasters</option><option value="multi">Multi-roaster sellers</option></select></div>
  <label class="cafe-filter" for="directory-cafe"><input type="checkbox" id="directory-cafe" class="checkbox checkbox-sm" />With a cafe</label>
  <button id="directory-reset" type="button" class="text-button">Clear filters</button>
</div>
<div class="results-heading"><p id="directory-count" role="status" aria-live="polite">{listings.length} listings</p><p class="muted">Listed A–Z</p></div>
<div class="list-heading" aria-hidden="true"><span>Roaster</span><span>Where</span><span>Good to know</span><span>Explore</span></div>
<section id="list-of-roasters" aria-label="Roaster results" class="roaster-list">{listings.map(roaster => <RoasterRow roaster={roaster} />)}</section>
<p id="directory-empty" class="empty-state" hidden>No roasters match these filters. Try another name or clear the filters.</p>
<script>
  const search = document.querySelector<HTMLInputElement>('#directory-search');
  const state = document.querySelector<HTMLSelectElement>('#directory-state');
  const type = document.querySelector<HTMLSelectElement>('#directory-type');
  const cafe = document.querySelector<HTMLInputElement>('#directory-cafe');
  const count = document.querySelector<HTMLElement>('#directory-count');
  const empty = document.querySelector<HTMLElement>('#directory-empty');
  const rows = [...document.querySelectorAll<HTMLElement>('#list-of-roasters .roaster-row')];
  function filter(updateUrl = true) {
    const onlineOnly = type.value === 'multi';
    state.disabled = onlineOnly;
    document.querySelector<HTMLElement>('#directory-state-field').hidden = onlineOnly;
    if (onlineOnly) state.value = '';
    const terms = search.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const row of rows) {
      const matches = terms.every(term => row.dataset.search.includes(term)) &&
        (!state.value || row.dataset.state.split(',').map(s => s.trim()).includes(state.value) || row.dataset.state === 'all') &&
        (!type.value || row.dataset.multi === String(type.value === 'multi')) &&
        (!cafe.checked || row.dataset.cafe === 'true');
      row.hidden = !matches;
      if (matches) visible++;
    }
    count.textContent = `${visible} ${visible === 1 ? 'listing' : 'listings'}`;
    empty.hidden = visible !== 0;
    if (updateUrl || onlineOnly) {
      const url = new URL(window.location.href);
      for (const [key, value] of Object.entries({ q: search.value, state: state.value, type: type.value, cafe: cafe.checked ? 'true' : '' })) {
        if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
      }
      history.replaceState(null, '', url);
    }
  }
  function restore() {
    const params = new URLSearchParams(window.location.search);
    search.value = params.get('q') ?? '';
    state.value = statesFromOptions(state, params.get('state'));
    type.value = statesFromOptions(type, params.get('type'));
    cafe.checked = params.get('cafe') === 'true';
    filter(false);
  }
  function statesFromOptions(select: HTMLSelectElement, value: string | null) { return [...select.options].some(option => option.value === value) ? value : ''; }
  search.addEventListener('input', () => filter());
  for (const control of [state, type, cafe]) control.addEventListener('change', () => filter());
  document.querySelector('#directory-reset').addEventListener('click', () => { search.value = ''; state.value = ''; type.value = ''; cafe.checked = false; filter(); search.focus(); });
  window.addEventListener('popstate', restore);
  restore();
</script>
