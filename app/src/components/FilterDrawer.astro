---
import { states } from "../data/states";
const pathname = Astro.url.pathname;
const { showStateFilter = true } = Astro.props;
---
<div class="directory-layout">
  <nav aria-label="Directory navigation" class="directory-nav">
    <a href="/roasters/" aria-current={pathname === '/roasters/' ? 'page' : undefined}>All listings</a>
    <a href="/roasters/online-subscriptions/1" aria-current={pathname.includes('online-subscriptions') ? 'page' : undefined}>Multi-roaster sellers</a>
    {showStateFilter && <details class="state-menu">
      <summary>Browse by state</summary>
      <ul>{states.map(state => <li><a href={`/roasters/${state.code}/false/1`} aria-current={pathname.includes(`/${state.code}/`) ? 'page' : undefined}>{state.name} <span>{state.code}</span></a></li>)}</ul>
    </details>}
  </nav>
  <slot name="main-content" />
</div>
<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.state-menu')) {
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); }
    });
    document.addEventListener('click', event => { if (!menu.contains(event.target as Node)) menu.open = false; });
  }
</script>
