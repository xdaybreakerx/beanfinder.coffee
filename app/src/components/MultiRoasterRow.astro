---
interface Store {
  Name: string;
  businessId: string;
  Website: string;
  subscription?: boolean;
  selection?: string[];
  brew?: string[];
}
interface Props { store: Store; }
const { store } = Astro.props;
const domain = new URL(store.Website).hostname.replace(/^www\./, '');
const selectionLabels: Record<string, string> = { surprise: 'Surprise me', choose: 'Choose your own' };
const brewLabels: Record<string, string> = { filter: 'Filter', espresso: 'Espresso', decaf: 'Decaf' };
---
<article data-business-id={store.businessId} class="seller-row" data-name={store.Name}>
  <div class="roaster-identity roaster-name">
    <h2><a class="roaster-name-link link link-hover" href={store.Website} target="_blank" rel="noopener noreferrer"><span class="roaster-title">{store.Name}</span><span class="sr-only"> (opens in a new tab)</span></a></h2>
    <span class="roaster-domain">{domain}</span>
  </div>
  <div class="seller-cell seller-subscription" role="group" aria-label="Subscription">
    <span class="seller-cell-label" aria-hidden="true">Subscription</span>
    {store.subscription === true && <span class="badge subscription-badge">Subscription</span>}
    {store.subscription === false && <span class="badge badge-outline store-only">Store Only</span>}
  </div>
  <div class="seller-cell seller-selection" role="group" aria-label="Selection">
    <span class="seller-cell-label" aria-hidden="true">Selection</span>
    <div class="flex flex-wrap gap-1.5">{(store.selection ?? []).map(selection => <span class="badge badge-outline selection-badge">{selectionLabels[selection] ?? selection}</span>)}</div>
  </div>
  <div class="seller-cell seller-brew" role="group" aria-label="Brew">
    <span class="seller-cell-label" aria-hidden="true">Brew</span>
    <div class="flex flex-wrap gap-1.5">{(store.brew ?? []).map(brew => <span class="badge badge-sm brew-badge">{brewLabels[brew] ?? brew}</span>)}</div>
  </div>
</article>
