---

---

<!-- app/public/__forms.html mirrors these fields for Netlify form detection. -->
 
<div class="roaster-form">
  <form id="roaster-form" name="roaster-form" method="POST" action="/__forms" data-netlify-honeypot="bot-field">
    <!-- Hidden input for the form name, necessary for Netlify to identify the form -->
    <input type="hidden" name="form-name" value="roaster-form" />
    <!-- For Netlify form notification -->
    <input
      type="hidden"
      name="subject"
      value="Coffee Roaster Update from Netlify submission"
    />
    <!-- Hidden field for the honeypot -->
    <p class="hidden">
      <label>
        Don’t fill this out if you’re human: <input name="bot-field" />
      </label>
    </p>
    <div class="space-y-12">
      <div class="border-b pb-12">
        <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
          <div class="border-b pb-12">
            <h2 class="text-base font-semibold leading-7">The Roaster</h2>
            <p class="mt-1 text-sm leading-6">
              Great coffee starts with great beans, from great farms, but the
              roasting process plays a critical role in your cup. Thank you for
              making this resource better for everyone.
            </p>
            <div class="mt-10 space-y-10">
              <fieldset>
                <legend class="text-sm font-semibold">What would you like to submit?</legend>
                <div class="mt-6 space-y-4">
                  <label class="flex items-center gap-3" for="recommendation">
                    <input id="recommendation" name="submission-type" type="radio" value="recommendation" class="radio radio-sm" required />
                    Recommend a new roaster
                  </label>
                  <label class="flex items-center gap-3" for="issue">
                    <input id="issue" name="submission-type" type="radio" value="issue" class="radio radio-sm" required />
                    Correct an existing listing
                  </label>
                </div>
              </fieldset>
            </div>
          </div>
          <div class="sm:col-span-4 p-4 space-y-4">
            <!-- Roaster Name input -->
            <label
              for="roaster-name"
              class="block text-sm font-medium leading-6">Roaster Name</label
            >
            <div class="mt-2">
              <div
                class="flex rounded-md shadow-xs ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-600 sm:max-w-md"
              >
                <input
                  type="text"
                  name="roaster-name"
                  id="roaster-name"
                  class="block flex-1 border-0 bg-transparent py-1.5 pl-1 placeholder:text-gray-400 focus:ring-0 sm:text-sm sm:leading-6"
                  maxlength="120"
                  placeholder="Coffee Roasting Co"
                  required
                />
              </div>
            </div>
            <!-- Roaster Website input -->
            <label
              for="roaster-website"
              class="block text-sm font-medium leading-6">Roaster Website</label
            >
            <div class="mt-2">
              <div
                class="flex rounded-md shadow-xs ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-600 sm:max-w-md"
              >
                <input
                  type="url"
                  name="roaster-website"
                  id="roaster-website"
                  class="block flex-1 border-0 bg-transparent py-1.5 pl-1 placeholder:text-gray-400 focus:ring-0 sm:text-sm sm:leading-6"
                  maxlength="2048"
                  placeholder="https://www.coffee.com.au"
                  required
                />
              </div>
            </div>
            <div id="correction-fields" hidden>
              <label for="original-website" class="block text-sm font-medium leading-6">Current listing website</label>
              <input type="url" id="original-website" name="original-website" maxlength="2048" class="input w-full" placeholder="https://current-website.com.au" />
              <p class="mt-1 text-sm">If the website has changed, include the old address so we can find the listing.</p>
            </div>
            <label for="has-cafe" class="block text-sm font-medium leading-6">Does it have a cafe?</label>
            <select id="has-cafe" name="has-cafe" class="select w-full max-w-xs">
              <option value="">Select an option</option>
              <option value="true">Yes</option>
              <option value="false">No</option>
            </select>
            <label for="multi-roaster" class="block text-sm font-medium leading-6">Does it sell beans from multiple roasters?</label>
            <select id="multi-roaster" name="multi-roaster" class="select w-full max-w-xs">
              <option value="">Select an option</option>
              <option value="false">No, it roasts its own beans</option>
              <option value="true">Yes, it is a multi-roaster service</option>
            </select>
            <p id="correction-hint" class="text-sm" hidden>For corrections, leave state and cafe/service options blank to keep the current values.</p>
            <!-- Roaster State dropdown -->
            <div class="dropdown-content shadow bg-base-100 rounded-box w-52">
              <label for="state" class="block text-sm font-medium leading-6"
                >Select Roaster State</label
              >
              <select
                id="state"
                name="state"
                class="select w-full max-w-xs ring-gray-300"
              >
                <option value="">Select a state</option>
                <option value="all">Nationwide multi-roaster service</option>
                <option value="NSW">New South Wales</option>
                <option value="VIC">Victoria</option>
                <option value="QLD">Queensland</option>
                <option value="WA">Western Australia</option>
                <option value="SA">South Australia</option>
                <option value="TAS">Tasmania</option>
                <option value="ACT">Australian Capital Territory</option>
                <option value="NT">Northern Territory</option>
              </select>
            </div>
            <label for="details" class="block text-sm font-medium leading-6">Details</label>
            <textarea id="details" name="details" maxlength="2000" class="textarea w-full" rows="4" placeholder="Tell us what to add or correct"></textarea>
            <p class="text-sm">Your roaster details and notes may appear publicly in the proposed update. Please leave out personal information.</p>
          </div>
        </div>
        <p id="submission-error" role="alert" class="text-error" hidden></p>
        <!-- Form submission buttons -->
        <div class="mt-6 flex items-center justify-end gap-x-6">
          <button type="button" class="btn btn-ghost">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit</button>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#roaster-form');
  const errorMessage = document.querySelector<HTMLElement>('#submission-error');
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
  const selectedType = () => form.querySelector<HTMLInputElement>('input[name="submission-type"]:checked')?.value;

  function updateFields() {
    const correction = selectedType() === 'issue';
    document.querySelector<HTMLElement>('#correction-fields').hidden = !correction;
    document.querySelector<HTMLElement>('#correction-hint').hidden = !correction;
    for (const id of ['state', 'has-cafe', 'multi-roaster']) {
      form.querySelector<HTMLSelectElement>(`#${id}`).required = !correction;
    }
    form.querySelector<HTMLTextAreaElement>('#details').required = correction;
  }
  form.addEventListener('change', updateFields);
  form.querySelector<HTMLButtonElement>('button[type="button"]').addEventListener('click', () => {
    form.reset();
    updateFields();
    errorMessage.hidden = true;
  });
  updateFields();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitButton.disabled) return;
    const state = form.querySelector<HTMLSelectElement>('#state').value;
    const multi = form.querySelector<HTMLSelectElement>('#multi-roaster').value;
    if (state === 'all' && multi !== 'true') {
      errorMessage.textContent = 'Nationwide listings must be multi-roaster services. Select a state for an individual roaster.';
      errorMessage.hidden = false;
      return;
    }
    submitButton.disabled = true;
    errorMessage.hidden = true;
    const formData = new FormData(form);
    if (selectedType() !== 'issue') formData.delete('original-website');
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new URLSearchParams(Array.from(formData, ([key, value]) => [key, String(value)])),
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      });
      if (!response.ok) throw new Error('Submission failed');
      window.location.href = '/success';
    } catch {
      errorMessage.textContent = 'We could not submit your update. Please try again.';
      errorMessage.hidden = false;
      submitButton.disabled = false;
    }
  });
</script>
