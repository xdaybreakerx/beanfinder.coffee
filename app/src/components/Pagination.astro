---
export interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl: string;
  nextUrl: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---

<nav aria-label="Pagination" class="pagination">
  {currentPage > 1 ? <a href={prevUrl} class="btn btn-outline" rel="prev">Previous</a> : <span class="btn btn-outline btn-disabled" aria-disabled="true">Previous</span>}
  <p>Page {currentPage} of {lastPage}</p>
  {currentPage < lastPage ? <a href={nextUrl} class="btn btn-outline" rel="next">Next</a> : <span class="btn btn-outline btn-disabled" aria-disabled="true">Next</span>}
</nav>
