<label for="theme-controller" class="theme-toggle" id="theme-toggle">
  <input type="checkbox" id="theme-controller" aria-label="Toggle dark mode" />
  <svg class="theme-sun" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="theme-moon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a9 9 0 1 0 11 11Z"/></svg>
</label>
<script>
  const toggle = document.querySelector<HTMLInputElement>('#theme-controller');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let explicit = false;
  try { explicit = ['light', 'dark', 'caramellatte', 'coffee'].includes(localStorage.getItem('theme')); } catch { /* Storage can be unavailable. */ }
  const sync = () => { toggle.checked = document.documentElement.dataset.theme === 'coffee'; };
  sync();
  toggle.addEventListener('change', () => {
    explicit = true;
    const theme = toggle.checked ? 'coffee' : 'caramellatte';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch { /* The current visit still updates. */ }
  });
  system.addEventListener('change', event => {
    if (!explicit) { document.documentElement.dataset.theme = event.matches ? 'coffee' : 'caramellatte'; sync(); }
  });
</script>
