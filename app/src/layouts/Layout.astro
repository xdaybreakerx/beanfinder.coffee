---
import Header from "../components/Header.astro";
import FooterComponent from "../components/FooterComponent.astro";
import "../styles/global.css";
import { pageMetadata } from "../utils/pageMetadata";
const metadata = pageMetadata(Astro.url.pathname);
const title = Astro.props.title || metadata.title;
const description = Astro.props.description || metadata.description;
const socialImage = "https://beanfinder.coffee/beanfinder-og-v2.jpg";
const socialImageAlt = "BeanFinder — Australian coffee directory, beside a ceramic bowl of roasted coffee beans on a cream background.";
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'coffee' || theme === 'dark' ? 'coffee' : theme === 'caramellatte' || theme === 'light' ? 'caramellatte' : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'coffee' : 'caramellatte');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={metadata.canonical} />
    {(Astro.props.noindex || metadata.noindex) && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph meta tags -->
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:image"
      content={socialImage}
    />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:url" content={metadata.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BeanFinder" />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <title>{title}</title>
  </head>

  <body class="site-shell">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header>
      <Header />
      <!-- Named slot for dynamic content -->
      <slot name="header-content" />
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <FooterComponent />
    </footer>
  </body>
</html>
