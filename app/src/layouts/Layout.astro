---
import Header from "../components/Header.astro";
import FooterComponent from "../components/FooterComponent.astro";
import "../styles/global.css";
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Discover Australia's finest coffee roasters with BeanFinder. Explore a curated list of roasters by state or find exclusive online multi-roaster subscriptions. Whether you're looking for a local café or a unique online experience, BeanFinder connects you with the best in Australian coffee."
    />

    <!-- Open Graph meta tags -->
    <meta
      property="og:title"
      content="BeanFinder - Discover Australia's Finest Coffee Roasters"
    />
    <meta
      property="og:description"
      content="Explore a curated list of the best coffee roasters in Australia."
    />
    <meta
      property="og:image"
      content="https://beanfinder.coffee/beanfinder-og-image.png"
    />
    <meta property="og:url" content="https://beanfinder.coffee/" />
    <meta property="og:type" content="website" />

    <!-- Google Analytic tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XX128J4Z0N"
    ></script>

    <title>{Astro.props.title || "BeanFinder"}</title>
    <!-- Google Analytics -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-XX128J4Z0N");
    </script>
  </head>

  <body class="site-shell">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header>
      <Header />
      <!-- Named slot for dynamic content -->
      <slot name="header-content" />
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <FooterComponent />
    </footer>
  </body>
</html>
